{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic held-out instrument-validation analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "validation_id", "metric_id", "authorities", "analysis", "domain", "denominators", "agreement", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_type": {"const": "external_target_metric_analysis_v1"},
    "validation_id": {"type": "string", "minLength": 1},
    "metric_id": {"const": "relative_cheek_CIELAB_Lstar_v1"},
    "authorities": {"type": "object"},
    "analysis": {"type": "object"},
    "domain": {"type": "object"},
    "denominators": {
      "type": "object",
      "required": ["planned_comparisons", "eligible_reference_change_comparisons", "metric_successes", "detector_failure_rows", "mask_failure_rows", "any_detector_or_mask_failure_rows", "full_denominator_reported", "detector_and_mask_failures_are_outcomes"]
    },
    "agreement": {"type": "object"},
    "decision": {
      "type": "object",
      "required": ["technical_thresholds_evaluable", "technical_thresholds_met", "threshold_checks", "external_validity_approved", "independent_review_supplied", "collection_approval_implied"],
      "properties": {
        "external_validity_approved": {"const": false},
        "independent_review_supplied": {"const": false},
        "collection_approval_implied": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
