{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/step6_readiness_report.schema.json",
  "title": "TMLR Step 6 collection-readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "study_id",
    "decision",
    "authorities",
    "inputs",
    "validation_scope",
    "criteria"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "readiness_id": {"const": "tmlr_collection_readiness_v1"},
    "study_id": {"const": "skin_tone_steering_confirmatory_v1"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_ready",
        "decision_rule",
        "required_criteria_count",
        "passed_criteria_count",
        "blocked_criteria_count",
        "blockers"
      ],
      "properties": {
        "collection_ready": {"type": "boolean"},
        "decision_rule": {"const": "all_required_criteria_must_pass"},
        "required_criteria_count": {"const": 7},
        "passed_criteria_count": {"type": "integer", "minimum": 0, "maximum": 7},
        "blocked_criteria_count": {"type": "integer", "minimum": 0, "maximum": 7},
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "code", "message"],
            "properties": {
              "criterion_id": {"type": "string"},
              "code": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    },
    "authorities": {
      "type": "object",
      "required": [
        "study_config",
        "evaluation_protocol",
        "readiness_protocol",
        "storage_policy",
        "source_registry",
        "metric_artifact_registry"
      ]
    },
    "inputs": {"type": "object"},
    "validation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmatory_images_generated",
        "confirmatory_matrix_executed",
        "expensive_sdxl_model_loaded",
        "real_person_images_used_by_synthetic_checks",
        "synthetic_fixture_evidence_is_external_validation"
      ],
      "properties": {
        "confirmatory_images_generated": {"const": false},
        "confirmatory_matrix_executed": {"const": false},
        "expensive_sdxl_model_loaded": {"const": false},
        "real_person_images_used_by_synthetic_checks": {"const": false},
        "synthetic_fixture_evidence_is_external_validation": {"const": false}
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "required",
          "status",
          "validated_properties",
          "evidence",
          "blockers",
          "limitations"
        ],
        "properties": {
          "criterion_id": {"type": "string"},
          "required": {"const": true},
          "status": {"enum": ["passed", "blocked"]},
          "validated_properties": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array"},
          "blockers": {"type": "array"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
